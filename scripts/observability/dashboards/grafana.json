{
  "uid": "course-grafana", "title": "Grafana: self-observability", "schemaVersion": 39,
  "tags": ["course"], "editable": true, "refresh": "30s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id": 1, "title": "Scrape health (1 = up)", "type": "stat", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "up{job=\"grafana\"}", "instant": true}]},
    {"id": 2, "title": "Resident memory", "type": "timeseries", "gridPos": {"x": 6, "y": 0, "w": 9, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "bytes"}}, "targets": [{"refId": "A", "expr": "process_resident_memory_bytes{job=\"grafana\"}"}]},
    {"id": 3, "title": "CPU cores", "type": "timeseries", "gridPos": {"x": 15, "y": 0, "w": 9, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "rate(process_cpu_seconds_total{job=\"grafana\"}[5m])"}]},
    {"id": 4, "title": "HTTP requests / sec", "type": "timeseries", "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (handler, status_code) (rate(grafana_http_request_duration_seconds_count{job=\"grafana\"}[5m]))", "legendFormat": "{{handler}} {{status_code}}"}]},
    {"id": 5, "title": "HTTP p95 latency", "type": "timeseries", "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "s"}}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(grafana_http_request_duration_seconds_bucket{job=\"grafana\"}[5m])))", "legendFormat": "{{handler}}"}]},
    {"id": 6, "title": "Grafana container logs — expand a line for TraceID link", "type": "logs", "gridPos": {"x": 0, "y": 13, "w": 24, "h": 10}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "{namespace=\"monitoring\", service_name=\"grafana\"}", "queryType": "range"}]}
  ]
}
