{
  "uid": "course-kubernetes", "title": "Kubernetes: workloads and resources", "schemaVersion": 39,
  "tags": ["course"], "editable": true, "refresh": "30s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id": 1, "title": "Ready nodes", "type": "stat", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})", "instant": true}]},
    {"id": 2, "title": "Pods by phase", "type": "timeseries", "gridPos": {"x": 6, "y": 0, "w": 9, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (phase) (kube_pod_status_phase)", "legendFormat": "{{phase}}"}]},
    {"id": 3, "title": "Scrape health", "type": "table", "gridPos": {"x": 15, "y": 0, "w": 9, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "up", "instant": true, "format": "table"}]},
    {"id": 4, "title": "Deployment available replicas", "type": "timeseries", "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "kube_deployment_status_replicas_available", "legendFormat": "{{namespace}}/{{deployment}}"}]},
    {"id": 5, "title": "Container restarts (15m)", "type": "timeseries", "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total[15m]))", "legendFormat": "{{namespace}}/{{pod}}"}]},
    {"id": 6, "title": "Pod CPU (cores)", "type": "timeseries", "gridPos": {"x": 0, "y": 13, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",container!=\"\",container!=\"POD\",pod!=\"\"}[5m]))", "legendFormat": "{{namespace}}/{{pod}}"}]},
    {"id": 7, "title": "Pod working set memory", "type": "timeseries", "gridPos": {"x": 12, "y": 13, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "bytes"}}, "targets": [{"refId": "A", "expr": "sum by (namespace, pod) (container_memory_working_set_bytes{job=\"cadvisor\",container!=\"\",container!=\"POD\",pod!=\"\"})", "legendFormat": "{{namespace}}/{{pod}}"}]}
  ]
}
